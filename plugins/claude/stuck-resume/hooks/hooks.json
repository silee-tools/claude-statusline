{
  "description": "Stuck resume hooks",
  "hooks": {
    "StopFailure": [
      {
        "matcher": "rate_limit|authentication_failed|server_error|overloaded",
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/resume.sh",
            "asyncRewake": true,
            "timeout": 3600
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh ${CLAUDE_PLUGIN_ROOT}/scripts/resume.sh",
            "timeout": 40
          }
        ]
      }
    ]
  }
}
